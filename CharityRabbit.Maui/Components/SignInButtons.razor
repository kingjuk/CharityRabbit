@* Sign in with Apple first (App Store guideline 4.8: offered alongside Google, at least as
   prominent), then Keycloak's own page for Google or email. *@
@inject CharityRabbit.Maui.Services.AuthService Auth
@inject ISnackbar Snackbar

<button type="button" class="cr-apple-btn" @onclick="@(() => SignInAsync(CharityRabbit.Maui.Services.AppConfig.AppleIdentityProvider))" disabled="@_busy">
    <svg viewBox="0 0 17 20" aria-hidden="true"><path fill="currentColor" d="M14.06 10.6c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.64.8-3.33.8-.69 0-1.74-.78-2.87-.76-1.47.02-2.83.86-3.59 2.18-1.53 2.66-.39 6.6 1.1 8.76.73 1.06 1.6 2.24 2.73 2.2 1.1-.04 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.07 2.65-2.13.84-1.22 1.18-2.41 1.2-2.47-.03-.01-2.3-.88-2.3-3.52zM11.88 4.12c.6-.73 1.01-1.75.9-2.76-.87.04-1.92.58-2.54 1.31-.56.64-1.05 1.68-.92 2.67.97.08 1.96-.49 2.56-1.22z"/></svg>
    <span>@(_busy && _provider is not null ? "Opening…" : "Sign in with Apple")</span>
</button>
<MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="mt-3"
           StartIcon="@Icons.Material.Filled.Login" OnClick="@(() => SignInAsync(null))" Disabled="_busy">
    @(_busy && _provider is null ? "Opening sign-in…" : "Sign in with Google or email")
</MudButton>

@code {
    private bool _busy;
    private string? _provider;

    private async Task SignInAsync(string? provider)
    {
        _busy = true;
        _provider = provider;
        try
        {
            var error = await Auth.LoginAsync(provider);
            if (error is not null) Snackbar.Add($"Sign-in failed: {error}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
